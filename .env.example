# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (local: printed by `pnpm db:start`; cloud: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: hub ingest and /api/sim routes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for the seeded dev hub; the /sim page sends it as the device token
HUB_DEV_SECRET=dev-hub-secret

# Default wear profile for new closets: real | demo (demo uses seconds)
WEAR_PROFILE=demo
