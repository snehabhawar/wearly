# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project: Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Safe in the browser: RLS guards reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: a secret key (sb_secret_...) or the legacy service_role key. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for the seeded dev hub; the /sim page sends it as the device token
HUB_DEV_SECRET=dev-hub-secret

# Default wear profile for new closets: real | demo (demo uses seconds)
WEAR_PROFILE=demo

# FASHN (app.fashn.ai/api). Server-only. Background removal for garment photos (1 credit each),
# live try-on in Style it (1 credit per garment) and scripts/generate-tryon.ts.
FASHN_API_KEY=

# Turns /sim and /api/sim/* on in production (always on in development). Only the signed-in
# owner of the dev hub's closet can use them.
SIM_ENABLED=false

# New live try-ons per closet per 24 h (each is 1-3 FASHN credits). Reused outfits are free.
TRYON_DAILY_LIMIT=10

# Claude API (console.anthropic.com). Server-only. Names garments from their photos.
# Optional: without it, photos are saved untagged.
ANTHROPIC_API_KEY=
